{#-
  =============================================================================
  timeline.njk — a timeline of one or two lanes, in chapters
  =============================================================================
  Rendered by the `timeline` shortcode (.eleventy.js) from _data/timelines/<key>.json; schema documented in articles/README.md.
  Figures take any image; SVGs are inlined so they take the lane's colour.

  Without JavaScript it reads as an ordered list of chapters, each an ordered list of events, in reading order whichever lane they sit in.
  The opening and closing paragraphs, from between the shortcode's tags, come before and after it.
  js/timeline.js lays the list out along the lanes, in a stage that scrolls sideways, pushing the opening out and pulling the closing in.
-#}
{%- set lane1 = timeline.lanes[0] -%}
{%- set lane2 = timeline.lanes[1] -%}
<section class="c-timeline{% if not lane2 %} c-timeline--single{% endif %}" data-timeline>
  <div class="c-timeline__stage">
    {%- if opening %}
    <div class="c-timeline__bookend c-timeline__bookend--opening u-flow">
      {{ opening | safe }}
    </div>
    {%- endif %}
    <div class="c-timeline__track">
      <ol class="c-timeline__chapters">
        {%- for chapter in timeline.chapters %}
        <li class="c-timeline__chapter" id="{{ chapter.title | slugify }}" data-rails="{{ chapter.rails }}">
          <div class="c-timeline__chapter-heading">
            <p class="c-timeline__chapter-label">Chapter {{ ("0" + loop.index).slice(-2) }} · {{ chapter.period }}</p>
            <h2 class="c-timeline__chapter-title">{{ chapter.title }}</h2>
          </div>
          <p class="c-timeline__chapter-summary">{{ chapter.summary | safe }}</p>
          <ol class="c-timeline__events">
            {%- for event in chapter.events %}
            {%- if event.lane == lane1.id %}{% set lane = lane1 %}{% set modifier = "lane-1" %}
            {%- elif lane2 and event.lane == lane2.id %}{% set lane = lane2 %}{% set modifier = "lane-2" %}
            {%- else %}{% set lane = null %}{% set modifier = "crossover" %}{% endif %}
            <li class="c-timeline__event c-timeline__event--{{ modifier }}{% if event.figure %} c-timeline__event--figure{% endif %}">
              <p class="c-timeline__event-label">
                {%- if r/^\d{4}$/.test(event.year) -%}
                <time class="c-timeline__year" datetime="{{ event.year }}">{{ event.year }}</time>
                {%- else -%}
                <span class="c-timeline__year">{{ event.year }}</span>
                {%- endif %} · {% if lane %}{{ lane.name }}{% else %}{{ timeline.crossover.name }}{% endif -%}
              </p>
              <h3 class="c-timeline__event-title">{{ event.title }}</h3>
              <p class="c-timeline__event-body">{{ event.body | safe }}</p>
              {%- if event.figure %}
              {%- set figure = event.figure %}
              <figure class="c-timeline__figure{% if figure.hideOnMobile %} c-timeline__figure--hide-on-mobile{% endif %}">
                {%- if figure.src.endsWith(".svg") %}
                {{ figure.src | inlineSvg(figure.alt) | safe }}
                {%- else %}
                <img class="c-timeline__image" src="{{ figure.src | url }}" alt="{{ figure.alt }}" loading="lazy" decoding="async">
                {%- endif %}
                <figcaption class="c-timeline__caption">
                  <b class="c-timeline__caption-title">{{ figure.title }}</b>
                  {{ figure.caption }}
                </figcaption>
              </figure>
              {%- endif %}
            </li>
            {%- endfor %}
          </ol>
        </li>
        {%- endfor %}
      </ol>
    </div>
    {%- if closing %}
    <div class="c-timeline__bookend c-timeline__bookend--closing u-flow">
      {{ closing | safe }}
    </div>
    {%- endif %}
  </div>
</section>
