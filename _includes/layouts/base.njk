<!doctype html>
<!-- Current page: {{ page.url | url }} -->
<html lang="en" dir="ltr" style="--static:url(../img/src/static.gif);--portrait:url(../img/src/bg.jpg);">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>{{ title or metadata.title }}</title>
    <meta name="description" content="{{ description or metadata.description }}">
    <link rel="canonical" href="{{ page.url or metadata.canonical | url }}">
    <!-- OpenGraph -->
    <meta property="og:type" content="{{ type or 'website' }}">
    <meta property="og:url" content="{{ page.url | url }}">
    <meta property="og:title" content="{{ title or metadata.title }}">
    <meta property="og:image" content="{{ thumb or metadata.image.thumb }}">
    <meta property="og:image:alt" content="{{ thumbAlt or metadata.image.alt }}">
    <meta property="og:description" content="{{ description or metadata.description }}">
    <meta property="og:site_name" content="{{ metadata.siteName }}">
    <meta property="og:locale" content="en_GB">
    <!-- Pinterest -->
    <meta name="p:domain_verify" content="{{ metadata.social.pinterestClaim}}"/>
    <!-- Localised versions -->
    <link rel="alternate" href="{{ page.url or metadata.canonical | url }}" hreflang="x-default"/>
    <!-- Favicons et al -->
    <link rel="apple-touch-icon" sizes="180x180" href="img/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="img/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="img/favicon/favicon-16x16.png">
    <link rel="manifest" href="img/favicon/site.webmanifest">
    <meta name="apple-mobile-web-app-title" content="Tylen St Hilaire">
    <meta name="apple-mobile-web-app-capable" content="no">
    <meta name="apple-mobile-web-app-status-bar-style" content="translucent-black">
    <meta name="application-name" content="Tylen St Hilaire">
    <meta name="msapplication-config" content="img/favicon/browserconfig.xml"/>
    <meta name="msapplication-TileColor" content="#c4662f">
    <meta name="theme-color" content="#ffffff">
    <!-- Feeds -->
    <link rel="alternate" href="{{ metadata.feed.path | url }}" type="application/atom+xml" title="{{ metadata.title }}">
    <link rel="alternate" href="{{ metadata.jsonfeed.path | url }}" type="application/json" title="{{ metadata.title }}">
    <!-- Preconnect hints -->
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <!-- Styles -->
    <link rel="preload" as="style" href="{{ '/css/critical.css' | url }}">
    <link rel="preload" as="style" href="{{ '/css/main.css' | url }}">
    <link rel="stylesheet" href="{{ '/css/main.css' | url }}" media="print" onload="this.onload=null;this.removeAttribute('media');">
    <noscript><link rel="stylesheet" href="{{ '/css/main.css' | url }}"></noscript>
    {%- if templateClass == "o-resume" %}
    {#- Loaded here only, so its @page rules style the printed résumé alone. #}
    <link rel="stylesheet" href="{{ '/css/resume-print.css' | url }}" media="print">
    {%- endif %}
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital@0;1&display=swap" rel="stylesheet">
    <!-- Local scripts -->
    <script async="async" src="{{ '/js/main.js' | url }}"></script>
    <!-- Analytics: Umami, cookie-free; see /privacy/ -->
    <script defer src="https://cloud.umami.is/script.js" data-website-id="e838da5f-40b5-44f4-8e06-984854b18cfe" data-domains="tylensthilaire.com"></script>
  </head>
  <body>
    <main id="content" {% if templateClass %} class="{{ templateClass }}" {% endif %}>
      {{ content | safe }}
    </main>
    {#- Masthead sits after <main> in the DOM (main content first for assistive
        tech); the flex body reorders it to the top visually — see .c-masthead. #}
    <header class="c-masthead">
      <a class="c-masthead__logo c-hero__eyebrow" href="{{ '/' | url }}">Tylen St Hilaire</a>
    </header>
    <footer class="c-footer">
      <hr class="u-visually-hidden">
      <h2 class="u-visually-hidden">P.S.</h2>
      <p class="c-footer__strapline">Strategy<span class="u-visually-hidden">,</span>
        <span class="u-ornament-bullet">Experience</span><span class="u-visually-hidden">,</span>
        <span class="u-ornament-bullet">Growth</span></p>
      <div class="c-footer__row">
        <dl class="c-footer__contact">
          <dt>Let's talk:</dt>
          <dd><a href="mailto:hello@tylensthilaire.com">hello@tylensthilaire.com</a></dd>
          <dt>About me:</dt>
          <dd><a href="{{ '/resume/' | url }}">Resume</a></dd>
          <dt>My work:</dt>
          <dd><a href="/img/TylenStHilaire-Portfolio.pdf">Case Studies</a></dd>
        </dl>
        {#- Visit counter: js/main.js fills in the number from /api/visits and
            strikes the cookie through when this browser has opted out. #}
        <a class="c-footer__counter" href="{{ '/privacy/' | url }}" data-visit-counter>
          <svg class="c-footer__counter-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
            <path d="M20.5 12.5a8.5 8.5 0 1 1-9-9 3 3 0 0 0 3.5 3.5 3 3 0 0 0 3 3 2.5 2.5 0 0 0 2.5 2.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
            <circle cx="8.5" cy="10" r="1.2" fill="currentColor"/>
            <circle cx="12.5" cy="13.5" r="1.2" fill="currentColor"/>
            <circle cx="8.5" cy="15.5" r="1" fill="currentColor"/>
            <circle cx="15.5" cy="16.5" r="1" fill="currentColor"/>
            <line class="c-footer__counter-strike" x1="3" y1="21" x2="21" y2="3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          <span data-visit-count>Privacy</span>
        </a>
      </div>
    </footer>
  </body>
</html>
